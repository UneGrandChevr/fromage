<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <FrameLayout
        android:id="@+id/CheeseLayout"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:background="#525452">

        <ImageView
            android:id="@+id/CheeseIcon"
            android:layout_width="94dp"
            android:layout_height="103dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="2dp"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/TitreCheese"
            android:layout_width="286dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="105dp"
            android:text="Camembert"
            android:textColor="#FAC900"
            android:textSize="26dp" />

        <TextView
            android:id="@+id/ActionCheese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="105dp"
            android:layout_marginTop="30dp"
            android:text="Le camembert est un fromage français à pâte molle et croûte fleurie, fabriqué à base de lait de vache. Il est crémeux, parfumé et connu pour son goût doux et légèrement boisé."
            android:textColor="#FFEA2C"
            android:textSize="15dp" />
    </FrameLayout>
</LinearLayout>